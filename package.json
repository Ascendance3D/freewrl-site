{
  "name": "freewrl-site",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-xite.mjs && vite",
    "build": "node scripts/sync-xite.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/build-legacy.mjs",
    "typecheck": "node scripts/sync-xite.mjs && tsc -b",
    "lint": "oxlint",
    "preview": "npm run build && wrangler dev",
    "assets:brand": "python3 scripts/make_brand.py",
    "assets:captures": "python3 scripts/make_captures.py",
    "assets:archive": "python3 scripts/make_archive_media.py && python3 scripts/make_tests_manifest.py",
    "data:releases": "node scripts/fetch-releases.mjs",
    "world:hero": "node scripts/gen-landing-world.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "x_ite": "16.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.142.0"
  }
}
