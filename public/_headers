/assets/*
  Cache-Control: public, max-age=31536000, immutable
/x_ite/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
/worlds/*
  Cache-Control: public, max-age=3600
/data/*
  Cache-Control: public, max-age=3600
/legacy/*
  Cache-Control: public, max-age=86400
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
