  rotation 0 1 0 0.637
  children [
    Transform { translation -2.4 -2.6 0 children Shape { appearance USE INK geometry Box { size 0.7 10 1.2 } } }
    Transform { translation 2.4 -3.85 0 children Shape { appearance USE INK geometry Box { size 0.7 7.5 1.2 } } }
    Transform { translation 0.6 2.5 0 rotation 0 0 1 -0.105 children Shape { appearance USE RESEARCH_BLUE geometry Box { size 7.4 0.6 1.4 } } }
    Transform { translation 0.6 2.2 0.72 rotation 0 0 1 -0.105 children Shape { appearance USE ANNOTATION_GOLD geometry Box { size 7.4 0.1 0.04 } } }
    Shape { appearance USE LINE_CYAN geometry IndexedLineSet {
      coord Coordinate { point [ -2.03 -7.6 0.61, -2.03 2.4 0.61 ] }
      coordIndex [ 0 1 -1 ] } }
  ]
}

Transform { # sky structure: a suspended slab
  children [
    Transform { translation 2 13.5 -17 rotation 0 0 1 -0.122 children Shape { appearance USE RESEARCH_BLUE geometry Box { size 22 0.5 3.4 } } }
    Transform { translation 2 13.2 -15.28 rotation 0 0 1 -0.122 children Shape { appearance USE ANNOTATION_GOLD geometry Box { size 22 0.12 0.06 } } }
    Shape { appearance USE LINE_CYAN geometry IndexedLineSet {
      coord Coordinate { point [ -8.9 14.8 -17, -14.5 18.4 -9, 12.9 12.1 -17, 18 -7.6 -26 ] }
      coordIndex [ 0 1 -1 2 3 -1 ] } }
  ]
}

