Transform { # foreground: plinth with an x, y, z marker
  children [
    Transform { translation -10.5 -6.7 10 children Shape { appearance USE INK geometry Box { size 6 1.8 4 } } }
    Shape { appearance USE LINE_CYAN geometry IndexedLineSet {
      coord Coordinate { point [ -13.5 -5.79 12.01, -7.5 -5.79 12.01 ] }
      coordIndex [ 0 1 -1 ] } }
    Transform {
      translation -10.5 -5.8 10
      children [
        Transform { translation 1.2 0.08 0 children Shape { appearance USE ANNOTATION_GOLD geometry Box { size 2.4 0.16 0.16 } } }
        Transform { translation 0 1.2 0 children Shape { appearance USE PAPER_WHITE geometry Box { size 0.16 2.4 0.16 } } }
        Transform { translation 0 0.08 1.2 children Shape { appearance USE FREEWRL_CYAN geometry Box { size 0.16 0.16 2.4 } } }
        Transform { translation 0 0.15 0 children Shape { appearance USE MARK_ORANGE geometry Box { size 0.4 0.3 0.4 } } }
      ]
    }
  ]
}

# One clock drives all motion, so pausing "Clock" stills the whole world.
DEF Clock TimeSensor { cycleInterval 72 loop TRUE }
DEF GyroTurn OrientationInterpolator { key [ 0 0.25 0.5 0.75 1 ] keyValue [ 0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832 ] }
DEF OrbitTurn OrientationInterpolator { key [ 0 0.25 0.5 0.75 1 ] keyValue [ 0 1 0 0, 0 1 0 -1.5708, 0 1 0 -3.1416, 0 1 0 -4.7124, 0 1 0 -6.2832 ] }
ROUTE Clock.fraction_changed TO GyroTurn.set_fraction
ROUTE Clock.fraction_changed TO OrbitTurn.set_fraction
ROUTE GyroTurn.value_changed TO Gyro.set_rotation
ROUTE OrbitTurn.value_changed TO Orbit.set_rotation
