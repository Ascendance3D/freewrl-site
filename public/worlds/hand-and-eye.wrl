DEF Clock TimeSensor { cycleInterval 60 loop TRUE }
DEF Spin OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 0 1 0 0, 0 1 0 3.1416, 0 1 0 6.2832 ] }
