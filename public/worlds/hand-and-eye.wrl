#VRML V2.0 utf8
# hand-and-eye.wrl — the FreeWRL mark, rebuilt from VRML97 primitives.
# Five capsules (Cylinder + two Spheres) and an eye (three shapes).
# Generated by scripts/gen-hero-world.mjs for freewrl.org.
# Try: change a finger's height, or the iris diffuseColor.

WorldInfo { title "hand-and-eye" info [ "freewrl.org hero world" ] }
NavigationInfo { type [ "EXAMINE" "ANY" ] headlight TRUE }
Background { skyColor [ 0.06 0.09 0.3, 0.03 0.05 0.17, 0.02 0.03 0.1 ] skyAngle [ 1.2, 1.5708 ] groundColor [ 0.02 0.03 0.1 ] }
DEF Front Viewpoint { position 0 1.3 11.5 description "Front" }
Viewpoint { position 11 9 11 orientation -0.6 0.77 0.22 0.9 description "Above" }
Viewpoint { position 0 0.8 5.5 description "Close" }
DirectionalLight { direction -0.4 -0.6 -0.7 intensity 0.6 }

DEF Hand Transform {
  translation 0 0 0
  children [
    Transform { # eyeball, flattened so the iris sits on its face
      scale 1 1 0.62
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.62 0.76 0.95 specularColor 1 1 1 shininess 0.8 } }
        geometry Sphere { radius 1.15 }
      }
    }
    Transform { # iris
      translation 0 0 0.735 rotation 1 0 0 1.5708
      children Shape {
        appearance Appearance { material DEF Iris Material { diffuseColor 0.04 0.28 0.85 emissiveColor 0.02 0.14 0.48 specularColor 0.25 0.3 0.4 shininess 0.3 } }
        geometry Cylinder { radius 0.64 height 0.06 }
      }
    }
    Transform { # pupil
      translation 0 0 0.775 rotation 1 0 0 1.5708
      children Shape {
        appearance Appearance { material Material { diffuseColor 0 0 0 specularColor 0.15 0.15 0.15 shininess 0.5 } }
        geometry Cylinder { radius 0.3 height 0.04 }
      }
    }
    Transform { # catch-light
      translation -0.26 0.28 0.8
      children Shape { appearance Appearance { material Material { diffuseColor 1 1 1 emissiveColor 0.9 0.95 1 } } geometry Sphere { radius 0.08 } }
    }
    Transform { # the five fingers
      children [
        Shape { appearance DEF Glass Appearance { material Material { diffuseColor 0.1 0.62 1 emissiveColor 0.04 0.4 0.78 specularColor 0.9 0.97 1 shininess 0.7 } } }
    Transform { # finger 1
      translation -2.3965 0.5094 0
      rotation 0 0 1 1.3614
      children [
        Shape { appearance USE Glass geometry Cylinder { radius 0.3 height 2.2 top FALSE bottom FALSE } }
        Transform { translation 0 1.1 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
        Transform { translation 0 -1.1 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
      ]
    }
    Transform { # finger 2
      translation -1.6851 2.2362 0
      rotation 0 0 1 0.6458
      children [
        Shape { appearance USE Glass geometry Cylinder { radius 0.3 height 2.7 top FALSE bottom FALSE } }
        Transform { translation 0 1.35 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
        Transform { translation 0 -1.35 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
      ]
    }
    Transform { # finger 3
      translation -0.157 2.9959 0
      rotation 0 0 1 0.0524
      children [
        Shape { appearance USE Glass geometry Cylinder { radius 0.3 height 3.1 top FALSE bottom FALSE } }
        Transform { translation 0 1.55 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
        Transform { translation 0 -1.55 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
      ]
    }
    Transform { # finger 4
      translation 1.338 2.5164 0
      rotation 0 0 1 -0.4887
      children [
        Shape { appearance USE Glass geometry Cylinder { radius 0.3 height 2.8 top FALSE bottom FALSE } }
        Transform { translation 0 1.4 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
        Transform { translation 0 -1.4 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
      ]
    }
    Transform { # finger 5
      translation 2.1386 1.3888 0
      rotation 0 0 1 -0.9948
      children [
        Shape { appearance USE Glass geometry Cylinder { radius 0.3 height 2.3 top FALSE bottom FALSE } }
        Transform { translation 0 1.15 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
        Transform { translation 0 -1.15 0 children Shape { appearance USE Glass geometry Sphere { radius 0.3 } } }
      ]
    }
      ]
    }
  ]
}

